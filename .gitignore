# ============================================================
# Personal Terminal — .gitignore
# Wails v2 project (Go backend + React/Vite frontend)
# ============================================================

# ── Wails build output ──────────────────────────────────────
build/
frontend/dist/

# ── Dependencies ────────────────────────────────────────────
node_modules/
frontend/node_modules/

# ── Go ──────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# ── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Environment & secrets ───────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── OS files ────────────────────────────────────────────────
$RECYCLE.BIN/
System Volume Information/

# ── Wails generated (decide per team) ───────────────────────
# Uncomment if you DON'T want to commit auto-generated bindings:
# frontend/wailsjs/
# frontend/src/wailsjs/

# ── SQLite / Database artifacts ─────────────────────────────
*.db
*.sqlite
*.db-journal
*.db-wal
*.db-shm

# ── Logs ────────────────────────────────────────────────────
*.log
logs/

# ── Temporary / misc ────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
_filelist.txt
dirlist.txt
